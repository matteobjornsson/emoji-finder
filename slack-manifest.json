{
  "display_information": {
    "name": "Emoji Finder",
    "description": "Find workspace emoji for a phrase, situation, or feeling",
    "background_color": "#245C45"
  },
  "features": {
    "bot_user": { "display_name": "Emoji Finder", "always_online": false },
    "app_home": { "messages_tab_enabled": true, "messages_tab_read_only_enabled": false }
  },
  "oauth_config": {
    "scopes": { "bot": ["chat:write", "emoji:read", "im:history"] }
  },
  "settings": {
    "socket_mode_enabled": false,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
